<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <actionName>run</actionName>
    <packagings><packaging>jar</packaging></packagings>
    <goals><goal>process-classes</goal><goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal></goals>
    <properties>
      <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
      <exec.executable>java</exec.executable>
      <exec.mainClass>com.railway.App</exec.mainClass>
      <exec.vmArgs></exec.vmArgs>
      <exec.appArgs>--demo</exec.appArgs>
    </properties>
  </action>
  <action>
    <actionName>debug</actionName>
    <packagings><packaging>jar</packaging></packagings>
    <goals><goal>process-classes</goal><goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal></goals>
    <properties>
      <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
      <exec.executable>java</exec.executable>
      <exec.mainClass>com.railway.App</exec.mainClass>
      <exec.vmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</exec.vmArgs>
      <exec.appArgs>--demo</exec.appArgs>
      <jpda.listen>true</jpda.listen>
    </properties>
  </action>
</actions>
